{
	"schemaVersion": 1,
	"id": "simula",
	"version": "${version}",
	"name": "Simula",
	"description": "Choose your beginning (simula) to gain benefits and/or drawbacks.",
	"authors": [
		"eggohito"
	],
	"contact": {
		"sources": "https://github.com/eggomods/simula",
		"issues": "https://github.com/eggomods/simula"
	},
	"license": "MIT",
	"icon": "assets/simula/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.eggohito.simula.Simula"
		],
		"client": [
			"io.github.eggohito.simula.SimulaClient"
		]
	},
	"mixins": [
		"simula.mixins.json",
		{
			"config": "simula.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": ">=${fabric}"
	},
	"accessWidener": "simula.classtweaker"
}